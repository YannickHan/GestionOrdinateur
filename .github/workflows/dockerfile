# Image de compilation commune aux projets .NET.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY GestionOrdinateurs.slnx .
COPY GestionOrdinateurs.API/GestionOrdinateurs.API.csproj GestionOrdinateurs.API/
COPY GestionOrdinateurs.Shared/GestionOrdinateurs.Shared.csproj GestionOrdinateurs.Shared/
COPY GestionOrdinateurs.Tests/GestionOrdinateurs.Tests.csproj GestionOrdinateurs.Tests/
COPY AuthentificationApi/AuthentificationApi.csproj AuthentificationApi/
COPY GestionOrdinateurs.Gateway/GestionOrdinateurs.Gateway.csproj GestionOrdinateurs.Gateway/
COPY GestionOrdinateurs.Client/GestionOrdinateurs.Client.csproj GestionOrdinateurs.Client/

RUN dotnet restore GestionOrdinateurs.slnx

COPY GestionOrdinateurs.API/ GestionOrdinateurs.API/
COPY GestionOrdinateurs.Shared/ GestionOrdinateurs.Shared/
COPY GestionOrdinateurs.Tests/ GestionOrdinateurs.Tests/
COPY AuthentificationApi/ AuthentificationApi/
COPY GestionOrdinateurs.Gateway/ GestionOrdinateurs.Gateway/
COPY GestionOrdinateurs.Client/ GestionOrdinateurs.Client/

RUN dotnet publish GestionOrdinateurs.API/GestionOrdinateurs.API.csproj \
    -c Release \
    -o /app/publish/api

RUN dotnet publish AuthentificationApi/AuthentificationApi.csproj \
    -c Release \
    -o /app/publish/authentification

RUN dotnet publish GestionOrdinateurs.Gateway/GestionOrdinateurs.Gateway.csproj \
    -c Release \
    -o /app/publish/gateway

RUN dotnet publish GestionOrdinateurs.Client/GestionOrdinateurs.Client.csproj \
    -c Release \
    -o /app/publish/client

# Cible API principale.
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS api
WORKDIR /app
COPY --from=build /app/publish/api .
EXPOSE 8080
ENTRYPOINT ["dotnet", "GestionOrdinateurs.API.dll"]

# Cible API d'authentification.
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS authentification
WORKDIR /app
COPY --from=build /app/publish/authentification .
EXPOSE 8080
ENTRYPOINT ["dotnet", "AuthentificationApi.dll"]

# Cible gateway.
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS gateway
WORKDIR /app
COPY --from=build /app/publish/gateway .
EXPOSE 8080
ENTRYPOINT ["dotnet", "GestionOrdinateurs.Gateway.dll"]

# Cible client Blazor publiée avec nginx.
FROM nginx:alpine AS client
COPY --from=build /app/publish/client/wwwroot /usr/share/nginx/html
COPY .github/workflows/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
ENTRYPOINT ["nginx", "-g", "daemon off;"]

# La construction sans --target produit l'image de l'API principale.
FROM api AS final
